FROM my-autoware:jazzy

# Global environment variables for all users and processes
ENV ROS_DOMAIN_ID=0
ENV ROS_LOCALHOST_ONLY=0
ENV CYCLONEDDS_URI=file:///home/aw/autoware/cyclonedds/cyclonedds.xml

# Create a shared setup script
RUN printf '%s\n' \
    'source /opt/ros/jazzy/setup.bash' \
    'if [ -f /home/aw/autoware/install/setup.bash ]; then' \
    '    source /home/aw/autoware/install/setup.bash' \
    'fi' \
    > /etc/autoware_env.sh && chmod 644 /etc/autoware_env.sh

# Load automatically in interactive shells for every user (including dynamic HOST_UID)
RUN echo 'source /etc/autoware_env.sh' >> /etc/bash.bashrc && \
    echo 'source /etc/autoware_env.sh' >> /etc/skel/.bashrc

# Load automatically in non-interactive "bash -c" commands
ENV BASH_ENV=/etc/autoware_env.sh